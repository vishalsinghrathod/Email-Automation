# ==============================================================================
# Vendor Inventory Email Automation System - Environment Configuration
# ==============================================================================

# Application Environment (development | production | demo)
APP_ENV=development

# Google Gmail API Credentials
# Download credentials.json from Google Cloud Console (OAuth 2.0 Client ID -> Desktop App)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Email Filtering Configuration
# Comma-separated subject/body keywords used to identify inventory emails
GMAIL_SEARCH_KEYWORDS=inventory,stock,catalog,supply,inventory update,item list
# Comma-separated list of registered vendor email addresses (empty = allow all active DB vendors)
REGISTERED_VENDOR_EMAILS=vendor.apex@gmail.com,sales@nexuslogistics.com,orders@primehardware.com,global.supplier@example.com

# Email Processing Actions
GMAIL_MARK_AS_READ=true
GMAIL_APPLY_LABEL=INVENTORY_PROCESSED
GMAIL_BATCH_SIZE=25

# Storage & Database
DATABASE_PATH=database/inventory.db
DOWNLOADS_DIR=data/downloads
PROCESSED_DIR=data/processed

# Data Processing & Validation Constraints
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls
MAX_FILE_SIZE_MB=25

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Scheduler Configuration (used by scheduler.py)
SCHEDULE_INTERVAL_MINUTES=15
SCHEDULE_LOCK_FILE=scheduler.lock
